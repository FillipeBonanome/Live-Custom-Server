<?xml version="1.0" encoding="ISO-8859-1"?>
<npc name="Mathias" floorchange="0" walkinterval="4000">
        <health now="150" max="150"/>
	<look type="332" head="0" body="0" legs="0" feet="0"  addons="0"/>

        <interaction range="3" idletime="30">

                <interact keywords="hi" focus="1">
                        <keywords>hello</keywords>

                        <response>
                                <action name="script">
                                <![CDATA[
                                selfSay("Welcome " .. getCreatureName(cid) .. ".Para passar pela porta diga {quest}", cid)
                                ]]>
                                </action>
                        </response>

                </interact>

                <interact keywords="bye" focus="0">
                        <keywords>farewell</keywords>
                        <response text="Good bye.">
                        </response>
                </interact>
        
                <interact keywords="quest" storageId="1031" storageValue="1" storageComp="less">
                        <response>
                                <action name="script">
                                <![CDATA[
                                selfSay("Quer abrir a porta por 100k ?", cid)
                                ]]>
                                </action>
                                <interact keywords="yes">
                                        <response>
                                                <action name="script">
                                                <![CDATA[
                                                if doPlayerRemoveMoney(cid, 100000) then
                                                    selfSay("Você ja pode passar por ela.", cid)
                                                    doPlayerSetStorageValue(cid, 1031, 1)
                                                else
                                                    selfSay("Você não possui gp's suficientes.", cid)
                                                end
                                                ]]>
                                                </action>
                                        </response>
                                </interact>
                        </response>
                </interact>
                
                <interact keywords="quest" storageId="1031" storageValue="1" storageComp="equal">
                        <response>
                                <action name="script">
                                <![CDATA[
                                selfSay("Você ja pode passar pela porta.", cid)
                                ]]>
                                </action>
                        </response>
                </interact>
        
        </interaction>

</npc>