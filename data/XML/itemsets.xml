<?xml version="1.0" encoding="UTF-8"?>
<!--
	Item sets.
	<set name="...">
		<item id="N"/>: a piece of the set (an item can only be part of one set).
		<bonus pieces="N">: bonuses active while N (or more) DIFFERENT pieces of the set are equipped.
			The bonuses of the lower piece counts stay active (they add up).
			<attribute name="..." value="N"/>: any attribute of rarity_attributes.xml except attack, defense and armor
				(dodge, criticalchance, maxhealthpoints, skillsword, speed, ...).
	The set shows in the item description ("set: name (equipped/total pieces)").
-->
<sets>
