		<item id="2491"/>
		<item id="2487"/>
		<item id="2488"/>
		<item id="2519"/>
		<bonus pieces="2">
			<attribute name="dodge" value="3"/>
			<attribute name="maxhealthpoints" value="50"/>
		</bonus>
		<bonus pieces="3">
			<attribute name="criticalchance" value="3"/>
			<attribute name="blockcount" value="1"/>
		</bonus>
		<bonus pieces="4">
			<attribute name="dodge" value="5"/>
			<attribute name="criticaldamage" value="10"/>
			<attribute name="lifeleech" value="2"/>
		</bonus>
	</set>

